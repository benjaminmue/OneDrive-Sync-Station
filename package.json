{
  "name": "onedrive-sync-station",
  "version": "0.4.2",
  "description": "Web UI + Docker container to sync multiple OneDrive Personal, Business and SharePoint accounts, built on the abraunegg OneDrive Client for Linux. Made for Unraid.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "onedrive-sync-station": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version"
  },
  "license": "MIT",
  "author": "benjaminmue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjaminmue/OneDrive-Sync-Station.git"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1"
  }
}
