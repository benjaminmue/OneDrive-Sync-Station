# Copy to .env for local development runs (docker compose reads it automatically).

# Where the station keeps its settings, the per-account client config and the
# Microsoft refresh tokens.
CONFIG_DIR=/config

# Where synced files land. One subfolder per account is created below this path.
DATA_DIR=/data

# Web UI port inside the container.
WEBUI_PORT=8080

# Container timezone, used for log timestamps in the UI.
TZ=Europe/Zurich

# File ownership of everything the container writes. Unraid defaults.
PUID=99
PGID=100
UMASK=0002

# Set to recover a lost web UI password: on the next start it overwrites the
# stored password and drops all sessions. Remove it again afterwards.
# ADMIN_PASSWORD=

# Skip the ownership repair on start. Only set this if you manage permissions
# on the host yourself.
FIX_PERMISSIONS=true
